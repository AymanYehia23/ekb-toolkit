#!/usr/bin/env bash
# Complete toolkit gate. Runs from any directory and keeps examples read-only.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
export EKB_PYTHON="${EKB_PYTHON:-python3}"
export PYTHONDONTWRITEBYTECODE=1

"$EKB_PYTHON" --version
ruby --version
bash -n scripts/ekb
bash -n scripts/ekb_git.sh
bash -n scripts/verify
for script in scripts/*.rb; do
  ruby -c "$script"
done
"$EKB_PYTHON" - <<'PY'
import json
from pathlib import Path
import yaml

for directory in ("config", "templates", "schema", "profiles", "examples", "tests/fixtures", ".github/workflows"):
    for path in Path(directory).rglob("*"):
        if path.suffix in (".json", ".yaml", ".yml"):
            text = path.read_text(encoding="utf-8")
            (json.loads if path.suffix == ".json" else yaml.safe_load)(text)
for path in Path("scripts").glob("*.py"):
    compile(path.read_bytes(), str(path), "exec")
print("Toolkit syntax and fixture data parse")
PY
"$EKB_PYTHON" -m unittest discover -s tests
"$EKB_PYTHON" tests/test_no_personal_data.py
ruby tests/test_resume_coverage.rb
ruby tests/test_resume_module.rb
