.DS_Store
__pycache__/
*.pyc
.venv/
venv/

# YOUR knowledge base. The default workspace lives inside the clone for a
# frictionless first run, and it is ignored so a `git push` of the toolkit can
# never carry your career data with it. Give it its own Git repository:
#
#     cd workspace && git init
#
# Everything except the directory skeleton is ignored.
workspace/*
!workspace/.gitkeep
!workspace/README.md

# Rendered example output. Regenerated by CI and by `ekb render`; the model and
# the validation report are what is worth reading.
examples/**/resume.docx
examples/**/resume.pdf
examples/**/*_CV.docx
examples/**/*_CV.pdf
examples/**/validation.json
